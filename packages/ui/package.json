{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "imports": {
    "#components/*": {
      "api-extractor": "./dist/components/*.d.ts",
      "default": "./src/components/*.tsx"
    },
    "#lib/*": {
      "api-extractor": "./dist/lib/*.d.ts",
      "default": "./src/lib/*.ts"
    },
    "#hooks/*": {
      "api-extractor": "./dist/hooks/*.d.ts",
      "default": "./src/hooks/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "api-report": "api-extractor run --local --verbose",
    "api-report:check": "api-extractor run --verbose",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.3",
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@turbo/gen": "^2.11.5",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  }
}
