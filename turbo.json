{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!etc/**", "!temp/**"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "api-report": {
      "dependsOn": ["build"],
      "inputs": [
        "config/api-extractor.json",
        "tsconfig.api.json",
        "tsconfig.build.json"
      ],
      "outputs": ["etc/**", "temp/**"]
    },
    "registry:build": {
      "dependsOn": ["^build"],
      "outputs": ["public/r/**", "registry/**", "registry.json"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
