{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "registry:build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!etc/**", "!temp/**"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "registry:build": {
      "dependsOn": ["^build"],
      "outputs": ["public/r/**", "registry/**", "registry.json"]
    }
  }
}
