{
  "root": "card",
  "elements": {
    "card": {
      "type": "Card",
      "props": { "className": "max-w-sm mx-auto" },
      "children": ["header", "content"]
    },
    "header": {
      "type": "CardHeader",
      "props": {},
      "children": ["title", "description"]
    },
    "title": {
      "type": "CardTitle",
      "props": { "text": "Welcome back" }
    },
    "description": {
      "type": "CardDescription",
      "props": { "text": "Sign in to your account to continue." }
    },
    "content": {
      "type": "CardContent",
      "props": {},
      "children": ["form"]
    },
    "form": {
      "type": "Stack",
      "props": { "direction": "column", "gap": 4 },
      "children": ["email", "password", "submit", "success"]
    },
    "email": {
      "type": "Input",
      "props": {
        "type": "email",
        "placeholder": "you@example.com",
        "value": { "$bindState": "/email" }
      }
    },
    "password": {
      "type": "Input",
      "props": {
        "type": "password",
        "placeholder": "Password",
        "value": { "$bindState": "/password" }
      }
    },
    "submit": {
      "type": "Button",
      "props": { "label": "Sign in", "className": "w-full" },
      "on": {
        "press": {
          "action": "setState",
          "params": { "statePath": "/submitted", "value": true }
        }
      }
    },
    "success": {
      "type": "Alert",
      "props": { "className": "mt-2" },
      "visible": { "$state": "/submitted" },
      "children": ["success-title"]
    },
    "success-title": {
      "type": "AlertTitle",
      "props": { "text": "Signed in successfully." }
    }
  },
  "state": { "email": "", "password": "", "submitted": false }
}
